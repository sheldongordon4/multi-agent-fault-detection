# Keep the build context small and Linux-clean.
.venv/
.git/
**/__pycache__/
*.pyo

# Secrets never go in the image (injected via env_file at runtime).
.env
.env.*
!.env.example

# Large / regenerable artifacts not needed to run the API.
data/testbed/
artifacts/
scratchpad/

# Dev-only tooling; the runtime image is built from the repo root.
.devcontainer/

# Docs / UI / tests aren't needed in the runtime image.
# NOTE: backend/tests/, not tests/ — a .dockerignore pattern is matched against
# the path from the context root, so `tests/` would no longer match now that the
# suite lives inside the backend package, and it would ship in the image.
docs/
ui/
backend/tests/
*.md
