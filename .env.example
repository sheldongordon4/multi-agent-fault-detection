APP_ENV=local
ENVIRONMENT=LOCAL

LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=changeme
LLM_MODEL=gemini-3.8-flash
# auto|google|openai — auto uses the native Google client for a generativelanguage
# endpoint (Gemini 3.x tool loops need it) and ChatOpenAI for everything else.
LLM_PROVIDER=auto
LLM_REQUESTS_PER_SECOND=1.0
LLM_MAX_BUCKET_SIZE=3
# Clamped in code to HARD_MAX_RETRIES=3 (app/faults/config.py) — a larger value here
# is silently lowered, not honoured.
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ENDPOINT_CALLS=150
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Host port 5433, not 5432: docker-compose.dev.yaml publishes the container DB on
# 5433 so a native host Postgres on 5432 cannot shadow it. In-container clients
# still use db:5432 (set in compose).
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mafd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/mafd

KAFKA_ENABLED=true
KAFKA_HOST=localhost
KAFKA_PORT=29092
