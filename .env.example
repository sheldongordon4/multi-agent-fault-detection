# ── App ───────────────────────────────────
APP_ENV=local
ENVIRONMENT=LOCAL

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini


LLM_REQUESTS_PER_SECOND=1.0
LLM_MAX_BUCKET_SIZE=3
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Cost guardrails. Configurable, but clamped by hard code ceilings you cannot
# exceed (retries<=3, output tokens<=2048, endpoint calls<=200).
# LLM_MAX_OUTPUT_TOKENS caps tokens billed per completion.
# LLM_MAX_ENDPOINT_CALLS is the TOTAL Azure chat calls this process may make
# before the coordinator permanently switches to the local (no-LLM) fallback.
LLM_MAX_OUTPUT_TOKENS=100
LLM_MAX_ENDPOINT_CALLS=3

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mafd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mafd

KAFKA_ENABLED=true
KAFKA_HOST=localhost
KAFKA_PORT=29092
