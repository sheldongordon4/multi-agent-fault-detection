# ── App ───────────────────────────────────
APP_ENV=local
ENVIRONMENT=LOCAL

# AI Foundry, called via the OpenAI-compatible route (no api-version needed).
# Must be the /openai/v1 path on the RESOURCE host. The Foundry project route
# (/api/projects/<project>) is a different, versioned API and returns
# "400 Missing required query parameter: api-version" for chat completions.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini


LLM_REQUESTS_PER_SECOND=1.0
LLM_MAX_BUCKET_SIZE=3
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Cost guardrails. Configurable, but clamped by hard code ceilings you cannot
# exceed (retries<=3, output tokens<=2048, endpoint calls<=150 — see
# app/faults/config.py). The EFFECTIVE budget is min(value here, hard ceiling),
# so raising the ceiling alone does nothing if this line is lower.
# LLM_MAX_OUTPUT_TOKENS caps tokens billed per completion.
# LLM_MAX_ENDPOINT_CALLS is the TOTAL Azure chat calls this process may make
# before the coordinator permanently switches to the local (no-LLM) fallback.
# At ~$0.015/call this is effectively a spend cap: 150 ~= $2.25.
# The Table 4 latency run needs (N_LLM_EVENTS + 1) * 2 = 102 calls.
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ENDPOINT_CALLS=150

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mafd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mafd

KAFKA_ENABLED=true
KAFKA_HOST=localhost
KAFKA_PORT=29092
