# ── App ───────────────────────────────────
APP_ENV=local
ENVIRONMENT=LOCAL

# ── LLM: Azure OpenAI (gpt-4o-mini deployment) ──
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── Coordinator LLM throttling / reliability ──
# Client-side token-bucket rate limit (tune to your Azure deployment's RPM),
# bounded retries, and a per-request timeout so a slow/failing call can't hang.
LLM_REQUESTS_PER_SECOND=1.0
LLM_MAX_BUCKET_SIZE=3
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ── Embeddings (local, self-hosted) ───────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Database (Postgres, async) ────────────
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mafd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mafd

# ── Kafka ─────────────────────────────────
KAFKA_ENABLED=true
KAFKA_HOST=localhost
KAFKA_PORT=29092
